/* Translucent black pill with the outline of the other lobby top bar buttons, a shade lighter than the fill; the fill lifts to grey on hover while top-up is possible */
.credits-panel {
    width: 112px;
    height: 46px;
    flex-direction: row;
    align-items: center;
    padding-left: 15px;
    border-width: 2px;
    border-radius: 23px;
    border-color: rgba(40, 40, 40, 0.55);
    background-color: rgba(0, 0, 0, 0.55);
    transition: background-color 0.1s;
}

.credits-panel--top-up:hover {
    background-color: rgba(90, 90, 90, 0.55);
}

.credits-panel--top-up:active {
    background-color: rgba(0, 0, 0, 0.55);
}

.credits-panel__icon {
    width: 32px;
    height: 32px;
    background-image: url('/Assets/DCL/MarketplaceCredits/Textures/NewCreditsLogo.png');
}

.credits-panel__amount {
    width: 55px;
    margin-left: 2px;
    font-size: 21.2px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
}
