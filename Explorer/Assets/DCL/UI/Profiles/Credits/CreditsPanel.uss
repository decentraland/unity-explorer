/* Translucent black pill with the outline of the other lobby top bar buttons; the fill lifts to grey on hover while top-up is possible */
.credits-panel {
    width: 112px;
    height: 42px;
    flex-direction: row;
    align-items: center;
    padding-left: 19px;
    border-width: 2px;
    border-radius: 21px;
    border-color: var(--lobby-white-5);
    background-color: rgba(0, 0, 0, 0.55);
    transition: background-color 0.1s;
}

.credits-panel--top-up:hover {
    background-color: rgba(90, 90, 90, 0.55);
}

.credits-panel--top-up:active {
    background-color: rgba(0, 0, 0, 0.55);
}

/* The coin fills its texture edge to edge, so it sits in a smaller box than the padded pill icons to read the same size */
.credits-panel__icon {
    width: 24px;
    height: 24px;
    background-image: url('/Assets/DCL/MarketplaceCredits/Textures/NewCreditsLogo.png');
}

.credits-panel__amount {
    width: 55px;
    margin-left: 6px;
    font-size: 16px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
}
