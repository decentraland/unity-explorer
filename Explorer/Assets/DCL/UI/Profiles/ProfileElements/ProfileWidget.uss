/* Outlined dark pill with the picture on the left and the texts centered in the rest; the outline lights up on hover */
.profile-widget {
    width: 167px;
    height: 46px;
    flex-direction: row;
    align-items: center;
    padding: 1px 10px 1px 1px;
    border-width: 2px;
    border-radius: 23px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(0, 0, 0, 0.6);
    transition: border-color 0.1s;
}

.profile-widget:hover {
    border-color: rgba(255, 255, 255, 0.3);
}

/* The profile color fills the circle while the picture is missing; the picture itself is set inline by the element */
.profile-widget__picture {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border-width: 2px;
    border-radius: 20px;
    border-color: rgba(255, 255, 255, 0.5);
    background-color: white;
    background-image: url('/Assets/DCL/Chat/Textures/DefaultProfileThumbnail.png');
    -unity-background-scale-mode: scale-and-crop;
}

.profile-widget--loading .profile-widget__picture {
    background-image: none;
}

/* The name and the wallet tag sit on one line, centered in what the picture leaves */
.profile-widget__texts {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

/* Takes the profile color, set inline by the element */
.profile-widget__name {
    flex-shrink: 1;
    font-size: 16px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.profile-widget__address {
    flex-shrink: 0;
    margin-left: 2px;
    font-size: 14px;
    -unity-text-align: middle-center;
    color: var(--dcl-color-silver);
}
