/* Translucent black 163x46 pill with an outline a shade lighter than the fill (the background does not extend under UI Toolkit borders); the fill lifts to grey on hover */
.profile-widget {
    width: 163px;
    height: 46px;
    flex-direction: row;
    align-items: center;
    border-width: 2px;
    border-radius: 23px;
    border-color: rgba(40, 40, 40, 0.55);
    background-color: rgba(0, 0, 0, 0.55);
    transition: background-color 0.1s;
}

.profile-widget:hover {
    background-color: rgba(90, 90, 90, 0.55);
}

/* 40px picture centred in the 42px content box of the pill; the profile color, its lighter border and the picture are set inline by the element */
.profile-widget__picture {
    position: absolute;
    left: 1px;
    top: 1px;
    width: 40px;
    height: 40px;
    border-width: 1px;
    border-radius: 20px;
    border-color: rgba(255, 255, 255, 0.2);
    background-color: white;
    background-image: url('/Assets/DCL/Chat/Textures/DefaultProfileThumbnail.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

.profile-widget--loading .profile-widget__picture {
    background-image: none;
}

.profile-widget__texts {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 47px;
    margin-right: 8px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.profile-widget__name {
    flex-shrink: 1;
    font-size: 16px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.profile-widget__address {
    flex-shrink: 0;
    margin-left: 2px;
    font-size: 14px;
    -unity-text-align: middle-center;
    color: var(--dcl-color-silver);
}

.profile-widget__address--empty {
    display: none;
}
