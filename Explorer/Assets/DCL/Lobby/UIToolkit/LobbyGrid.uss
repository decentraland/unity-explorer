/* A grid sizes itself in code from its cells (LobbyGridElement); the document pins it to its corner. The cell lines are
   painted by the element while editing */
.lobby-grid {
    position: absolute;
}

/* The outline of the grid a drag targets sits just outside its cells, as a child so a border on the grid itself would
   not shift the widgets inward */
.lobby-grid__outline {
    position: absolute;
    left: -6px;
    top: -6px;
    right: -6px;
    bottom: -6px;
    display: none;
    border-width: 2px;
    border-radius: 14px;
    border-color: rgba(255, 255, 255, 0.35);
}

.lobby-grid--highlighted .lobby-grid__outline {
    display: flex;
}
