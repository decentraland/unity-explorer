/* A grid sizes itself in code from its cells (LobbyGridElement); the document pins it to its corner. The anchor dots are
   painted by the element while editing */
.lobby-grid {
    position: absolute;
}

/* The backdrop tints the area of the grid while editing, a little past its cells: a child, as a background on the grid
   itself would stop at them. It brightens while a drag targets the grid */
.lobby-grid__backdrop {
    position: absolute;
    left: -6px;
    top: -6px;
    right: -6px;
    bottom: -6px;
    display: none;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.02);
    transition: background-color 0.1s;
}

.lobby-grid--editing .lobby-grid__backdrop {
    display: flex;
}

.lobby-grid--highlighted .lobby-grid__backdrop {
    background-color: rgba(255, 255, 255, 0.05);
}