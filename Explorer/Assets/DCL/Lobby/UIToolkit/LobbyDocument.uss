/* Layout of the uGUI lobby (LobbyUI.prefab) at 1920x1080: 50px margins, a 100px header band, the side columns at 180px and the place rows along the bottom. */
:root {
    --lobby-margin: 50px;
    --lobby-columns-top: 180px;
    --lobby-card-color: rgba(20, 20, 26, 0.9);
    --lobby-card-border-color: rgba(255, 255, 255, 0.1);
    --lobby-title-color: white;
    --lobby-subtitle-color: rgb(191, 191, 199);
}

.lobby {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* The banner texture fades from transparent at its top to opaque at its bottom; flipping it darkens the top edge instead */
.lobby__gradient {
    position: absolute;
    left: 0;
    right: 0;
    background-image: url('/Assets/Textures/ExplorePanel/GradientBanner.png');
    background-size: 100% 100%;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0.6);
}

.lobby__gradient--top {
    top: 0;
    height: 120px;
    scale: 1 -1;
}

.lobby__gradient--bottom {
    bottom: 0;
    height: 338px;
}

/* Backdrop of the active stage preset (GameWorld_01), covering the panel; the fill only shows through transparent pixels. */
/* Same footprint as the hit area button of the uGUI lobby: 440x820, centred and 60px down */
.lobby__avatar-hit-area {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 440px;
    height: 820px;
    margin-left: -220px;
    margin-top: -350px;
}

/* 874x120 texture at 256x35, centred in the 100px header band */
.lobby__logo {
    position: absolute;
    left: var(--lobby-margin);
    top: 32px;
    width: 256px;
    height: 35px;
    background-image: url('/Assets/Textures/ExplorePanel/DecentralandLogo.png');
}

/* The greeting and the landing card hang under the header along the left edge, the mirror of the events on the right. */
.lobby__welcome {
    position: absolute;
    left: var(--lobby-margin);
    top: var(--lobby-columns-top);
    width: 524px;
}

/* The section titles share one look: 24px Inter Bold, white, sentence case */
.lobby__welcome-title,
.lobby__events-title,
.lobby__friends-title,
.lobby__places-title {
    font-size: 24px;
    -unity-font-definition: var(--dcl-font-inter-bold);
    color: var(--lobby-title-color);
}

/* The friends and place titles are 30px tall with the text centred in them */
.lobby__friends-title,
.lobby__places-title {
    height: 30px;
    -unity-text-align: middle-left;
}

/* The welcome and events titles hang their text from the top of a 29px row */
.lobby__welcome-title,
.lobby__events-title {
    height: 29px;
    -unity-text-align: upper-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* 10px between the greeting and the landing card */
.lobby__welcome-title {
    margin-bottom: 10px;
}

/* The friends row sits under the landing card, its header centred 25.8px under the middle of the screen: 180px tall in all */
.lobby__friends {
    position: absolute;
    left: var(--lobby-margin);
    top: 566px;
    width: 524px;
}

.lobby__friends-header {
    height: 30px;
    flex-direction: row;
    align-items: center;
}

.lobby__friends-online-count {
    margin-left: 15px;
    font-size: 12px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-left;
    color: var(--lobby-subtitle-color);
}

/* The cards are 132px tall, 2px under the header; the rest is the dots row under the viewport */
.lobby__friends-rail {
    margin-top: 2px;
    height: 148px;
}

/* The events hang under the header along the right edge, one card wide: the live card on top, the upcoming card under it. */
.lobby__events {
    position: absolute;
    right: var(--lobby-margin);
    top: var(--lobby-columns-top);
    width: 358px;
}

/* The title is 29px tall with 9px under it, so the first card starts 38px under the section */
.lobby__events-title {
    margin-bottom: 9px;
}

/* The cards are 214px tall; the rest is the dots row under the viewport, and the row keeps 16px more under the dots */
.lobby__live-events {
    margin-bottom: 16px;
}

.lobby__live-events-rail {
    height: 230px;
}

.lobby__upcoming-events {
    margin-top: 4px;
}

/* The cards are 135px tall, 12px over the dots; the rest is the dots row under the viewport */
.lobby__upcoming-events-rail {
    height: 155px;
}

.lobby__upcoming-events-rail .lobby-rail__dots {
    margin-top: 12px;
}

/* The place rows sit along the bottom edge, one on each side of the avatar; three cards and their spacing fill a row. */
.lobby__places {
    position: absolute;
    bottom: 13px;
    width: 864px;
}

.lobby__places--recent {
    left: var(--lobby-margin);
}

.lobby__places--featured {
    right: var(--lobby-margin);
}

.lobby__places-title {
    margin-bottom: 5px;
}

/* The cards are 165px tall; the rest is the dots row under the viewport */
.lobby__places-rail {
    height: 181px;
}
