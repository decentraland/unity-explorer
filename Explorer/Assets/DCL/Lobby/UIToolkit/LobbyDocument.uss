.lobby {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Backdrop of the active stage preset (GameWorld_01), covering the panel; the fill only shows through transparent pixels. */
/* Same footprint as the hit area button of the uGUI lobby: 440x820, centred and 60px down */
.lobby__avatar-hit-area {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 440px;
    height: 820px;
    margin-left: -220px;
    margin-top: -350px;
}

/* The greeting and the landing card hang under the top bar along the left edge, the mirror of the events on the right. */
.lobby__welcome {
    position: absolute;
    left: 50px;
    top: 180px;
    width: 524px;
}

.lobby__welcome-title {
    height: 32px;
    margin-bottom: 10px;
    font-size: 24px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: white;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* The place rows sit along the bottom edge, one on each side of the avatar; three cards and their spacing fill a row. */
.lobby__places {
    position: absolute;
    bottom: 24px;
    width: 864px;
}

.lobby__places--recent {
    left: 50px;
}

.lobby__places--featured {
    right: 50px;
}

.lobby__places-title {
    height: 24px;
    font-size: 16px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-left;
    color: var(--dcl-color-snow);
}

/* The cards are 165px tall; the rest is the dots row under the viewport */
.lobby__places-rail {
    margin-top: 8px;
    height: 181px;
}

/* The friends row sits on the left, just under the vertical middle; four cards and their spacing fill it. */
.lobby__friends {
    position: absolute;
    left: 50px;
    top: 50%;
    margin-top: 26px;
    width: 524px;
    height: 180px;
}

.lobby__friends-header {
    height: 24px;
    flex-direction: row;
    align-items: center;
}

.lobby__friends-title {
    font-size: 18px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-left;
    color: white;
}

.lobby__friends-online-count {
    margin-left: 10px;
    font-size: 12px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-left;
    color: rgb(191, 191, 199);
}

/* The cards are 132px tall; the rest is the dots row under the viewport */
.lobby__friends-rail {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 148px;
}

/* The events hang under the top bar along the right edge, one card wide: the live card on top, the upcoming card under it. */
.lobby__events {
    position: absolute;
    right: 50px;
    top: 180px;
    width: 358px;
}

.lobby__events-title {
    height: 24px;
    font-size: 18px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-left;
    color: white;
}

.lobby__live-events,
.lobby__upcoming-events {
    margin-top: 16px;
}

/* The cards are 214px tall; the rest is the dots row under the viewport */
.lobby__live-events-rail {
    height: 230px;
}

/* The cards are 135px tall; the rest is the dots row under the viewport */
.lobby__upcoming-events-rail {
    height: 151px;
}
