/* Layout of the lobby at 1920x1080: the 50px side margins of the uGUI lobby (LobbyUI.prefab) and the vertical anchors of the
   design, the top grids 31px under the top bar and the bottom ones 26px off the bottom edge. The widgets keep their content
   10px inside their cells, so the grids sit that much further out sideways for the content to land on the margins */
:root {
    --lobby-margin: 50px;
    --lobby-widget-inset: 10px;
    --lobby-grid-margin: 40px;
    --lobby-grid-top: 104px;
    --lobby-bottom-margin: 26px;
    --lobby-card-color: rgba(20, 20, 26, 0.9);
    --lobby-card-border-color: rgba(255, 255, 255, 0.1);
    --lobby-title-color: white;
    --lobby-subtitle-color: rgb(191, 191, 199);
    --lobby-jump-in-color: rgb(255, 45, 85);
    --lobby-jump-in-hover-color: rgb(255, 77, 111);
    --lobby-jump-in-pressed-color: rgb(200, 35, 67);
    --lobby-thumbnail-fade-duration: 0.3s;
    /* The uGUI drop shadows: 9-sliced sprites authored at twice the size, drawn at half scale with the slices of their import settings */
    --lobby-button-shadow-image: url('/Assets/Textures/Common/Container12Shadow4.png');
    --lobby-card-shadow-image: url('/Assets/Textures/Common/Container24Shadow10.png');
}

.lobby {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Drawn with the sprite's 9-slice border: a 140px soft fade, a stretched middle and a 42px opaque strip along the bottom edge */
.lobby__gradient {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 338px;
    background-image: url('/Assets/Textures/ExplorePanel/GradientBanner.png');
    -unity-background-image-tint-color: rgba(0, 0, 0, 0.6);
}

/* Same footprint as the hit area button of the uGUI lobby: 440x820, centred and 60px down */
.lobby__avatar-hit-area {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 440px;
    height: 820px;
    margin-left: -220px;
    margin-top: -350px;
}

/* Left and top follow the pointer; the translate centres it on the pointer vertically */
.lobby__avatar-tooltip {
    position: absolute;
    height: 40px;
    flex-direction: row;
    align-items: center;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0.95);
    translate: 0 -50%;
}

.lobby__avatar-tooltip-icon {
    width: 22px;
    height: 22px;
    margin-right: 12px;
    background-image: url('/Assets/Textures/UI/Interaction/icon-mouse-left.png');
}

.lobby__avatar-tooltip-label {
    font-size: 16px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--lobby-title-color);
}

/* Name of a hovered friend picture; left and top follow the pointer, the translate centres it vertically */
.lobby__friend-tooltip {
    position: absolute;
    height: 32px;
    align-items: center;
    justify-content: center;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0.95);
    translate: 0 -50%;
}

.lobby__friend-tooltip-label {
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--lobby-title-color);
}

/* Left and top follow the pointer; the translate centres the sprite on it */
.lobby__avatar-drag-cursor {
    position: absolute;
    width: 52px;
    height: 52px;
    translate: -50% -50%;
    background-image: url('/Assets/DCL/Backpack/Textures/CursorRotate.png');
}

/* The grids size themselves from their cells; each one is pinned to its corner */
.lobby__grid--top-left {
    left: var(--lobby-grid-margin);
    top: var(--lobby-grid-top);
}

.lobby__grid--top-right {
    right: var(--lobby-grid-margin);
    top: var(--lobby-grid-top);
}

.lobby__grid--bottom-left {
    left: var(--lobby-grid-margin);
    bottom: var(--lobby-bottom-margin);
}

.lobby__grid--bottom-right {
    right: var(--lobby-grid-margin);
    bottom: var(--lobby-bottom-margin);
}

/* A widget section is placed by LobbyWidgetHost: its left, top, width and height are inline, from its cell and its span.
   The inset keeps the content off the edges of the cells, which the edit-mode frame runs along, so the content has to
   fit the cells less the inset (the title rows and the rails below add up to the span) */
.lobby__widget {
    position: absolute;
    padding: var(--lobby-widget-inset);
}

/* The four-column sections show two cards in the room of the seven-column ones' three: the cards of both fill their row,
   so they are narrower in the four-column ones (441px holds two, 790px holds three, 11px apart) */
.lobby__widget--narrow .lobby-place-card,
.lobby__widget--narrow .lobby-community-card,
.lobby__widget--narrow .lobby-gallery-card {
    width: 215px;
}

.lobby__unplaced-widgets {
    display: none;
}

.lobby__welcome-title,
.lobby__events-title,
.lobby__friends-title,
.lobby__places-title,
.lobby__communities-title,
.lobby__gallery-title {
    font-size: 24px;
    -unity-font-definition: var(--dcl-font-inter-bold);
    color: var(--lobby-title-color);
}

.lobby__friends-title {
    height: 30px;
    -unity-text-align: middle-left;
}

/* The label is as tall as its font, the glyphs overflowing it; the cards start 32px under the title, as the design has it */
.lobby__places-title,
.lobby__communities-title,
.lobby__gallery-title {
    height: 24px;
    margin-bottom: 8px;
    -unity-text-align: upper-left;
}

.lobby__welcome-title,
.lobby__events-title {
    height: 29px;
    -unity-text-align: upper-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lobby__welcome-title {
    margin-bottom: 10px;
}

.lobby__friends-header {
    height: 30px;
    flex-direction: row;
    align-items: center;
}

.lobby__friends-online-count {
    margin-left: 15px;
    font-size: 12px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-left;
    color: var(--lobby-subtitle-color);
}

/* A rail is as wide as one page of cards, so the next page never shows at its edge, and as tall as its cards plus the 32px
   pager band of LobbyRail.uss */

/* A pixel short of the design's 440px, which four 103px cards cannot share into whole-pixel gaps; spaced off the 30px header
   so the cards sit where the design has them */
.lobby__friends-rail {
    margin-top: 16px;
    width: 439px;
    height: 149px;
}

.lobby__friends-rail .lobby-rail__card {
    margin-right: 9px;
}

.lobby__events-title {
    margin-bottom: 8px;
}

.lobby__live-events-rail {
    width: 326px;
    height: 231px;
}

/* The viewport bleeds as far as the live cards' shadow (6px sideways, 10px down) so it clips at the shadow's edge instead of the
   card's; the padding keeps the cards in place and tells the rail how much of the viewport the cards have (see LobbyRailElement) */
.lobby__live-events-rail .lobby-rail__viewport {
    margin: 0 -6px -10px;
    padding: 0 6px 10px;
}

.lobby__live-events-rail .lobby-rail__content {
    left: 6px;
}

/* With the title band it fills the two rows of its section */
.lobby__upcoming-events-rail {
    width: 326px;
    height: 171px;
}

/* With the title band it fills the two rows of its section; the communities and gallery rails share the metrics as their
   cards are the size of the place cards */
.lobby__places-rail,
.lobby__communities-rail,
.lobby__gallery-rail {
    width: 790px;
    height: 178px;
}

.lobby__places-rail--4x2,
.lobby__communities-rail--4x2,
.lobby__gallery-rail--4x2 {
    width: 441px;
}

.lobby__places-rail .lobby-rail__card,
.lobby__communities-rail .lobby-rail__card,
.lobby__gallery-rail .lobby-rail__card {
    margin-right: 11px;
}

/* The recent row has no dots: its cards are padded by the pager band of the rail so both rows line up along the bottom */
.lobby__places-row {
    flex-direction: row;
    height: 146px;
    margin-bottom: 32px;
}

.lobby__places-row > .lobby-place-card {
    margin-right: 11px;
}

/* Inset past the pill (LobbyGoTo.uss) so the question lines up with the icon inside it */
.lobby__goto-title {
    height: 26px;
    margin: 0 10px 10px 20px;
    font-size: 18px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--lobby-title-color);
}
