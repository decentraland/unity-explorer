/* The upcoming event card of the uGUI lobby (EventCard_Small as the lobby overrode it): 358x135 with 24px corners, the thumbnail
   along its right edge. Hovering lifts the texts, fades the host out and brings the action buttons in where the schedule sat,
   the way the uGUI card animated */
:root {
    --upcoming-event-card-hover-duration: 0.2s;
}

.lobby-upcoming-event-card {
    width: 358px;
    height: 135px;
    border-radius: 24px;
    background-color: var(--lobby-card-color);
    overflow: hidden;
}

/* An event the user is interested in goes near black, the Remind me background of the uGUI lobby */
.lobby-upcoming-event-card--interested {
    background-color: rgba(8, 8, 10, 0.95);
}

/* 135px along the right edge with 8px corners; the card's own corners cut its outer ones. The texts and the buttons take the rest */
.lobby-upcoming-event-card__thumbnail {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 135px;
    border-radius: 8px;
    background-image: url('/Assets/Textures/ExplorePanel/DefaultImagePlace.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

.lobby-upcoming-event-card--loading .lobby-upcoming-event-card__thumbnail {
    background-image: none;
    background-color: rgb(207, 205, 212);
}

/* 18px in from the left edge, 28px down and 170px wide: the title over the host, then the schedule 12px under them */
.lobby-upcoming-event-card__info {
    position: absolute;
    left: 18px;
    top: 28px;
    width: 170px;
}

/* Hovering lifts the title and the host by 8px */
.lobby-upcoming-event-card__texts {
    transition: translate var(--upcoming-event-card-hover-duration) ease-out;
}

.lobby-upcoming-event-card:hover .lobby-upcoming-event-card__texts {
    translate: 0 -8px;
}

.lobby-upcoming-event-card__title {
    height: 24px;
    font-size: 20px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-left;
    color: var(--dcl-color-snow);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Fades out while the card is hovered */
.lobby-upcoming-event-card__host-row {
    height: 16px;
    flex-direction: row;
    align-items: center;
    transition: opacity var(--upcoming-event-card-hover-duration) ease-out;
}

.lobby-upcoming-event-card:hover .lobby-upcoming-event-card__host-row {
    opacity: 0;
}

.lobby-upcoming-event-card__host-prefix,
.lobby-upcoming-event-card__host {
    font-size: 13px;
    -unity-text-align: middle-left;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
}

.lobby-upcoming-event-card__host-prefix {
    margin-right: 3px;
    -unity-font-definition: var(--dcl-font-inter-regular);
}

/* The name takes what is left of the row and is cut short rather than pushing the row wider */
.lobby-upcoming-event-card__host {
    flex-shrink: 1;
    -unity-font-definition: var(--dcl-font-inter-bold);
    overflow: hidden;
    text-overflow: ellipsis;
}

/* A pill only as wide as its text, so the tint does not stretch across the column. Hovering lifts it by 30px, clear of the
   buttons that come in where it sat */
.lobby-upcoming-event-card__schedule {
    margin-top: 12px;
    height: 24px;
    align-self: flex-start;
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    border-radius: 7px;
    background-color: rgba(255, 255, 255, 0.03);
    transition: translate var(--upcoming-event-card-hover-duration) ease-out;
}

.lobby-upcoming-event-card:hover .lobby-upcoming-event-card__schedule {
    translate: 0 -30px;
}

.lobby-upcoming-event-card__schedule-icon {
    width: 20px;
    height: 20px;
    margin-right: 4px;
    background-image: url('/Assets/Textures/Common/TimeIcn.png');
}

.lobby-upcoming-event-card__schedule-text {
    font-size: 16px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-left;
    color: var(--dcl-color-snow);
}

/* Along the bottom-left, 18px in and 19px up: 36px buttons 8px apart. Invisible until the card is hovered, which any pointer over
   them is, so their invisible state never takes a click meant for the card itself */
.lobby-upcoming-event-card__actions {
    position: absolute;
    left: 18px;
    bottom: 19px;
    flex-direction: row;
    opacity: 0;
    transition: opacity var(--upcoming-event-card-hover-duration) ease-out;
}

.lobby-upcoming-event-card:hover .lobby-upcoming-event-card__actions {
    opacity: 1;
}

.lobby-upcoming-event-card__action {
    width: 36px;
    height: 36px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.03);
    transition: background-color 0.1s;
}

.lobby-upcoming-event-card__action:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.lobby-upcoming-event-card__action-icon {
    width: 24px;
    height: 24px;
}

/* The bell fills in once the user is interested, like the Remind me toggle of the Explore card */
.lobby-upcoming-event-card__action-icon--interested {
    background-image: url('/Assets/Textures/ExplorePanel/ReminderOff.png');
}

.lobby-upcoming-event-card--interested .lobby-upcoming-event-card__action-icon--interested {
    background-image: url('/Assets/Textures/ExplorePanel/ReminderOn.png');
}

.lobby-upcoming-event-card__action-icon--calendar {
    background-image: url('/Assets/Textures/ExplorePanel/AddToCalendarIcn.png');
}

.lobby-upcoming-event-card__action-icon--share {
    background-image: url('/Assets/Textures/Common/ShareIcn.png');
}
