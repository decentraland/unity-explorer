/* The upcoming event card of the uGUI lobby (EventCard_Small): 358x135 with 24px corners, the thumbnail along its right edge */
.lobby-upcoming-event-card {
    width: 358px;
    height: 135px;
    border-radius: 24px;
    background-color: var(--dcl-color-black-70);
    overflow: hidden;
}

/* An event the user is interested in is tinted like the Remind me state of the Explore card */
.lobby-upcoming-event-card--interested {
    background-color: rgb(152, 36, 226);
}

/* The texts and the buttons take the rest */
.lobby-upcoming-event-card__thumbnail {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 140px;
    background-image: url('/Assets/Textures/ExplorePanel/DefaultImagePlace.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

.lobby-upcoming-event-card--loading .lobby-upcoming-event-card__thumbnail {
    background-image: none;
    background-color: rgb(207, 205, 212);
}

/* 18px in from the left edge, 28px down, up to the thumbnail */
.lobby-upcoming-event-card__info {
    position: absolute;
    left: 18px;
    top: 28px;
    right: 158px;
    bottom: 0;
}

.lobby-upcoming-event-card__title {
    height: 24px;
    font-size: 20px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-left;
    color: var(--dcl-color-snow);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lobby-upcoming-event-card__host {
    height: 16px;
    font-size: 13px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-left;
    color: rgba(255, 255, 255, 0.5);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* A pill only as wide as its text, so the tint does not stretch across the column */
.lobby-upcoming-event-card__schedule {
    margin-top: 12px;
    height: 24px;
    align-self: flex-start;
    flex-direction: row;
    align-items: center;
    padding: 0 4px;
    border-radius: 12px;
    background-color: var(--dcl-color-white-10);
}

.lobby-upcoming-event-card__schedule-icon {
    width: 20px;
    height: 20px;
    margin-right: 4px;
    background-image: url('/Assets/Textures/Common/TimeIcn.png');
}

.lobby-upcoming-event-card__schedule-text {
    font-size: 16px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-left;
    color: var(--dcl-color-snow);
}

/* Beside the thumbnail, only reachable while the card is hovered, so their invisible state never takes a click meant for the card itself */
.lobby-upcoming-event-card__actions {
    position: absolute;
    right: 150px;
    bottom: 10px;
    flex-direction: row;
    opacity: 0;
    transition: opacity 0.15s ease-out;
}

.lobby-upcoming-event-card:hover .lobby-upcoming-event-card__actions {
    opacity: 1;
}

.lobby-upcoming-event-card__action {
    width: 28px;
    height: 28px;
    margin-left: 6px;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background-color: var(--dcl-color-white-10);
    transition: background-color 0.1s;
}

.lobby-upcoming-event-card__action:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.lobby-upcoming-event-card__action-icon {
    width: 18px;
    height: 18px;
}

/* The star fills in once the user is interested, like the Explore card's toggle */
.lobby-upcoming-event-card__action-icon--interested {
    background-image: url('/Assets/Textures/ExplorePanel/InterestedOff.png');
}

.lobby-upcoming-event-card--interested .lobby-upcoming-event-card__action-icon--interested {
    background-image: url('/Assets/Textures/ExplorePanel/InterestedOn.png');
}

.lobby-upcoming-event-card__action-icon--calendar {
    background-image: url('/Assets/Textures/ExplorePanel/AddToCalendarIcn.png');
}

.lobby-upcoming-event-card__action-icon--share {
    background-image: url('/Assets/Textures/Common/ShareIcn.png');
}
