:root {
    --rail-snap-duration: 0.25s;
    --rail-arrow-fade-duration: 0.15s;
    --rail-dot-duration: 0.2s;
    --rail-dot-selected-color: rgb(255, 51, 153);
    --rail-dot-color: rgba(255, 255, 255, 0.4);
    --rail-pill-color: var(--dcl-color-black-70);
}

.lobby-rail {
    flex-direction: column;
}

.lobby-rail__viewport {
    flex-grow: 1;
    overflow: hidden;
}

/* Absolute so it keeps the width of its cards and overflows the viewport; the pages slide it through its translate. */
.lobby-rail__content {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    flex-direction: row;
    transition: translate var(--rail-snap-duration) ease-out;
}

.lobby-rail--instant .lobby-rail__content {
    transition-duration: 0s;
}

/* The strip is measured against the viewport, which would shrink the cards to fit it rather than let them overflow into pages */
.lobby-rail__card {
    flex-shrink: 0;
    margin-right: 8px;
}

/* The row under the cards is as tall as the dots; the pill is centred over it and overflows it, so the arrows and the
   background that come up on hover add nothing to the layout of the rail */
.lobby-rail__pager {
    height: 8px;
    margin-top: 8px;
}

.lobby-rail__pager-pill {
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    height: 32px;
    padding: 0 4px;
    border-radius: 16px;
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    transition: background-color var(--rail-arrow-fade-duration) ease-out;
}

.lobby-rail:hover .lobby-rail__pager-pill {
    background-color: var(--rail-pill-color);
}

.lobby-rail__arrow {
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 6px;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0);
    opacity: 0;
    transition: opacity var(--rail-arrow-fade-duration) ease-out, background-color 0.1s;
}

.lobby-rail:hover .lobby-rail__arrow {
    opacity: 1;
}

.lobby-rail__arrow:active {
    background-color: var(--dcl-color-black-80);
}

.lobby-rail__arrow-icon {
    width: 9px;
    height: 14px;
    background-image: url('/Assets/Textures/Common/ArrowLeft.png');
}

.lobby-rail__arrow--next .lobby-rail__arrow-icon {
    background-image: url('/Assets/Textures/Common/ArrowRight.png');
}

.lobby-rail__dots {
    margin: 0 12px;
    flex-direction: row;
    align-items: center;
}

.lobby-rail__dot {
    width: 8px;
    height: 8px;
    margin: 0 2px;
    border-radius: 4px;
    background-color: var(--rail-dot-color);
    transition: width var(--rail-dot-duration) ease-out, background-color var(--rail-dot-duration) ease-out;
}

.lobby-rail__dot--selected {
    width: 24px;
    background-color: var(--rail-dot-selected-color);
}
