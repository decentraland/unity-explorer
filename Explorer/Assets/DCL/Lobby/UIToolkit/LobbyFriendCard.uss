:root {
    --friend-card-status-online: rgb(52, 206, 119);
    --friend-card-status-away: rgb(255, 162, 90);
    --friend-card-status-offline: var(--dcl-color-silver);
    --friend-card-status-ring-color: rgb(22, 21, 24);
    /* Solid so the hover does not depend on what the stage shows behind the card */
    --friend-card-hover-color: rgb(37, 33, 42);
}

.lobby-friend-card {
    width: 103px;
    height: 117px;
    border-radius: 12px;
    background-color: var(--lobby-black-60);
    transition: background-color 0.1s;
}

.lobby-friend-card:hover {
    background-color: var(--friend-card-hover-color);
}

/* The profile color, its lighter border and the picture are set inline by the element */
.lobby-friend-card__picture {
    position: absolute;
    top: 12px;
    left: 31px;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    border-width: 3px;
    border-color: var(--lobby-white-40);
    background-color: white;
    background-image: url('/Assets/DCL/Chat/Textures/DefaultProfileThumbnail.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

.lobby-friend-card--loading .lobby-friend-card__picture {
    background-image: none;
}

/* The sweep runs over the profile colour, which stands in for the picture, inside the circle of the 3px border */
.lobby-friend-card__picture .skeleton-loading__bone {
    border-radius: 17px;
    background-color: rgba(0, 0, 0, 0);
}

.lobby-friend-card__online {
    position: absolute;
    top: 10px;
    left: 62px;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    border-width: 2px;
    border-color: var(--friend-card-status-ring-color);
    background-color: var(--friend-card-status-offline);
}

.lobby-friend-card--online .lobby-friend-card__online {
    background-color: var(--friend-card-status-online);
}

.lobby-friend-card--away .lobby-friend-card__online {
    background-color: var(--friend-card-status-away);
}

.lobby-friend-card__user-name {
    position: absolute;
    top: 58px;
    left: 10px;
    right: 10px;
    height: 17px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

/* The name takes the profile color, set inline by the element */
.lobby-friend-card__name {
    flex-shrink: 1;
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lobby-friend-card__wallet-tag {
    flex-shrink: 0;
    margin-left: 2px;
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
}

.lobby-friend-card--verified .lobby-friend-card__wallet-tag {
    display: none;
}

.lobby-friend-card__verified {
    display: none;
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    margin-left: 2px;
    background-image: var(--sprite-common__icon-verified);
}

.lobby-friend-card--verified .lobby-friend-card__verified {
    display: flex;
}

.lobby-friend-card__location {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 81px;
    height: 18px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

/* The pin sprite is taller than wide (36x43), so the box keeps its shape at the design's 14px height */
.lobby-friend-card__location-icon {
    flex-shrink: 0;
    width: 12px;
    height: 14px;
    margin-right: 2px;
    background-image: url('/Assets/Textures/Common/LocationIcn.png');
    -unity-background-image-tint-color: var(--dcl-color-silver);
}

.lobby-friend-card__location-text {
    flex-shrink: 1;
    font-size: 12px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-left;
    color: var(--lobby-subtitle-color);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Join replaces the location row while a joinable card is hovered, so it never takes a click meant for the card itself */
.lobby-friend-card__join {
    display: none;
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 12px;
    height: 24px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-radius: 7px;
    background-color: var(--lobby-jump-in-color);
    transition: background-color 0.1s;
}

.lobby-friend-card--joinable:hover .lobby-friend-card__join {
    display: flex;
}

.lobby-friend-card--joinable:hover .lobby-friend-card__location {
    display: none;
}

.lobby-friend-card__join:hover {
    background-color: var(--lobby-jump-in-hover-color);
}

.lobby-friend-card__join:active {
    background-color: var(--lobby-jump-in-pressed-color);
}

.lobby-friend-card__join-text {
    margin-right: 4px;
    font-size: 10px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
}

.lobby-friend-card__join-icon {
    width: 16px;
    height: 16px;
    background-image: url('/Assets/Textures/Common/JumpInOutline.png');
}
