:root {
    --friend-card-status-online: rgb(87, 223, 65);
    --friend-card-status-away: rgb(255, 162, 90);
    --friend-card-status-offline: var(--dcl-color-silver);
}

/* The Friends card of the design: 110x115 with 12px corners and padding, darker while hovered */
.lobby-friend-card {
    width: 110px;
    height: 115px;
    border-radius: 12px;
    background-color: rgba(22, 21, 24, 0.7);
    transition: background-color 0.1s;
}

.lobby-friend-card:hover {
    background-color: var(--dcl-color-shadow);
}

/* The profile color fills the circle while the picture is missing; the picture itself is set inline by the element */
.lobby-friend-card__picture {
    position: absolute;
    top: 10px;
    left: 37px;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.7);
    background-color: white;
    background-image: url('/Assets/DCL/Chat/Textures/DefaultProfileThumbnail.png');
    -unity-background-scale-mode: scale-and-crop;
}

.lobby-friend-card--loading .lobby-friend-card__picture {
    background-image: none;
}

/* Over the top-right of the picture */
.lobby-friend-card__online {
    position: absolute;
    top: 8px;
    left: 61px;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    border-width: 2px;
    border-color: var(--dcl-color-shadow);
    background-color: var(--friend-card-status-offline);
}

.lobby-friend-card--online .lobby-friend-card__online {
    background-color: var(--friend-card-status-online);
}

.lobby-friend-card--away .lobby-friend-card__online {
    background-color: var(--friend-card-status-away);
}

.lobby-friend-card__user-name {
    position: absolute;
    top: 48px;
    left: 10px;
    right: 10px;
    height: 17px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

/* The name takes the profile color, set inline by the element */
.lobby-friend-card__name {
    flex-shrink: 1;
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lobby-friend-card__wallet-tag {
    flex-shrink: 0;
    margin-left: 2px;
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
}

.lobby-friend-card--verified .lobby-friend-card__wallet-tag {
    display: none;
}

.lobby-friend-card__verified {
    display: none;
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    margin-left: 2px;
    background-image: var(--sprite-common__icon-verified);
}

.lobby-friend-card--verified .lobby-friend-card__verified {
    display: flex;
}

.lobby-friend-card__location {
    position: absolute;
    top: 69px;
    left: 10px;
    right: 10px;
    height: 24px;
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.lobby-friend-card__location-icon {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    background-image: url('/Assets/Textures/Common/LocationIcn.png');
    -unity-background-image-tint-color: var(--dcl-color-silver);
}

.lobby-friend-card__location-text {
    flex-shrink: 1;
    font-size: 12px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-left;
    color: var(--dcl-color-silver);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Join replaces the location row while a joinable card is hovered, so it never takes a click meant for the card itself */
.lobby-friend-card__join {
    display: none;
    position: absolute;
    top: 71px;
    left: 10px;
    right: 10px;
    height: 30px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    background-color: rgb(255, 45, 85);
    transition: background-color 0.1s;
}

.lobby-friend-card--joinable:hover .lobby-friend-card__join {
    display: flex;
}

.lobby-friend-card--joinable:hover .lobby-friend-card__location {
    display: none;
}

.lobby-friend-card__join:hover {
    background-color: rgb(255, 77, 111);
}

.lobby-friend-card__join:active {
    background-color: rgb(200, 35, 67);
}

.lobby-friend-card__join-text {
    margin-right: 4px;
    font-size: 11px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
}

.lobby-friend-card__join-icon {
    width: 13px;
    height: 12px;
    background-image: url('/Assets/Textures/Common/JumpInSolid.png');
}
