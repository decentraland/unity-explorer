/* 524x300 with 24px corners, the thumbnail filling it */
.lobby-landing-card {
    width: 524px;
    height: 300px;
    border-radius: 24px;
    background-color: var(--lobby-card-color);
    overflow: hidden;
}

.lobby-landing-card--static {
    background-color: rgba(16, 16, 20, 0.45);
}

.lobby-landing-card__thumbnail {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url('/Assets/Textures/ExplorePanel/DefaultImagePlace.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: opacity var(--lobby-thumbnail-fade-duration) ease-out;
}

/* While the picture is on its way the dark fill of the card shows; the picture then fades in over it rather than popping up */
.lobby-landing-card--loading .lobby-landing-card__thumbnail {
    opacity: 0;
    transition: opacity 0s;
}

.lobby-landing-card__gradient {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100px;
    background-image: url('/Assets/Textures/ExplorePanel/GradientBanner.png');
    background-size: 100% 100%;
    -unity-background-image-tint-color: var(--dcl-color-black-80);
}

.lobby-landing-card__online {
    position: absolute;
    top: 12px;
    left: 12px;
    height: 28px;
    flex-direction: row;
    align-items: center;
    padding: 0 6px;
    border-radius: 12px;
    background-color: var(--dcl-color-shadow);
    display: none;
}

.lobby-landing-card--with-online .lobby-landing-card__online {
    display: flex;
}

.lobby-landing-card__online-dot {
    width: 8px;
    height: 8px;
    margin-right: 4px;
    border-radius: 4px;
    background-color: rgb(48, 205, 0);
}

.lobby-landing-card__online-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    background-image: url('/Assets/Textures/Common/PlayersIcn.png');
}

.lobby-landing-card__online-count {
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    color: var(--dcl-color-snow);
}

.lobby-landing-card__footer {
    position: absolute;
    left: 16px;
    right: 190px;
    bottom: 16px;
}

.lobby-landing-card__title {
    height: 30px;
    margin-bottom: 4px;
    font-size: 22px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-font-style: bold;
    -unity-text-align: lower-left;
    color: white;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lobby-landing-card__creator {
    height: 22px;
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-left;
    color: var(--lobby-subtitle-color);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* The box runs 6px under the visible button for the shadow of its sprite (see LobbyDocument.uss); the label is padded off that strip */
.lobby-landing-card__jump-in {
    position: absolute;
    right: 15px;
    bottom: 10px;
    width: 155px;
    height: 46px;
    padding: 0 0 6px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: transparent;
    background-image: var(--lobby-button-shadow-image);
    -unity-slice-left: 26;
    -unity-slice-top: 24;
    -unity-slice-right: 25;
    -unity-slice-bottom: 36;
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: var(--lobby-jump-in-color);
    transition: -unity-background-image-tint-color 0.1s;
}

.lobby-landing-card__jump-in:hover {
    -unity-background-image-tint-color: var(--lobby-jump-in-hover-color);
}

.lobby-landing-card__jump-in:active {
    -unity-background-image-tint-color: var(--lobby-jump-in-pressed-color);
}

.lobby-landing-card__jump-in:disabled {
    opacity: 0.5;
}

.lobby-landing-card__jump-in-text {
    margin-right: 8px;
    font-size: 16px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
}

.lobby-landing-card__jump-in-icon {
    width: 24px;
    height: 24px;
    background-image: url('/Assets/Textures/Common/JumpInOutline.png');
}
