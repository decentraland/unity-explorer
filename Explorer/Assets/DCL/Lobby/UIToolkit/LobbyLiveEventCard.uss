/* The live event card of the uGUI lobby; it casts a shadow past its edges, so it does not clip and each layer rounds its own corners instead */
.lobby-live-event-card {
    width: 358px;
    height: 214px;
    border-radius: 24px;
    background-color: var(--lobby-card-color);
}

/* The 24px shadow sprite (see LobbyDocument.uss) hangs 6px past the sides and 10px under the card; tinted like the card, as the thumbnail covers it only once loaded */
.lobby-live-event-card__shadow {
    position: absolute;
    left: -6px;
    top: 0;
    right: -6px;
    bottom: -10px;
    background-image: var(--lobby-card-shadow-image);
    -unity-slice-left: 60;
    -unity-slice-top: 45;
    -unity-slice-right: 60;
    -unity-slice-bottom: 68;
    -unity-slice-scale: 0.5px;
    -unity-background-image-tint-color: var(--lobby-card-color);
}

.lobby-live-event-card__thumbnail {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-radius: 24px;
    background-image: url('/Assets/Textures/ExplorePanel/DefaultImagePlace.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: opacity var(--lobby-thumbnail-fade-duration) ease-out;
}

/* While the picture is on its way the dark fill of the card shows; the picture then fades in over it rather than popping up */
.lobby-live-event-card--loading .lobby-live-event-card__thumbnail {
    opacity: 0;
    transition: opacity 0s;
}

.lobby-live-event-card__gradient {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100px;
    border-bottom-left-radius: 24px;
    border-bottom-right-radius: 24px;
    background-image: url('/Assets/Textures/ExplorePanel/GradientBanner.png');
    background-size: 100% 100%;
    -unity-background-image-tint-color: var(--dcl-color-black-80);
}

.lobby-live-event-card__badges {
    position: absolute;
    top: 12px;
    left: 12px;
    height: 28px;
    flex-direction: row;
    align-items: center;
}

.lobby-live-event-card__live {
    height: 28px;
    margin-right: 6px;
    flex-direction: row;
    align-items: center;
    padding: 0 8px 0 6px;
    border-radius: 12px;
    background-color: rgb(255, 0, 0);
}

.lobby-live-event-card__live-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    background-image: url('/Assets/Textures/ExplorePanel/LiveIcn.png');
}

.lobby-live-event-card__live-text {
    font-size: 12px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
}

.lobby-live-event-card__attendees {
    height: 28px;
    flex-direction: row;
    align-items: center;
    padding: 0 6px;
    border-radius: 12px;
    background-color: var(--dcl-color-shadow);
}

.lobby-live-event-card__attendees-dot {
    width: 8px;
    height: 8px;
    margin-right: 4px;
    border-radius: 4px;
    background-color: rgb(48, 205, 0);
}

.lobby-live-event-card__attendees-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    background-image: url('/Assets/Textures/Common/PlayersIcn.png');
}

.lobby-live-event-card__attendees-count {
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
}

.lobby-live-event-card__title {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 42px;
    height: 30px;
    font-size: 22px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-font-style: bold;
    -unity-text-align: lower-left;
    color: white;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lobby-live-event-card__host {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    height: 22px;
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-left;
    color: var(--lobby-subtitle-color);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
