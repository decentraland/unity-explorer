/* The live Events card of the design: 358x199 with 24px corners, the thumbnail filling it */
.lobby-live-event-card {
    width: 358px;
    height: 199px;
    border-radius: 24px;
    background-color: var(--dcl-color-black-40);
    overflow: hidden;
}

/* The badges and the texts sit over it */
.lobby-live-event-card__thumbnail {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url('/Assets/Textures/ExplorePanel/DefaultImagePlace.png');
    -unity-background-scale-mode: scale-and-crop;
}

/* Without a thumbnail the dark fill of the card shows */
.lobby-live-event-card--loading .lobby-live-event-card__thumbnail {
    background-image: none;
}

/* Darkens the bottom of the thumbnail under the title and the host: 32px of fade over the two of them */
.lobby-live-event-card__gradient {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 83px;
    background-image: url('/Assets/Textures/ExplorePanel/GradientBanner.png');
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: var(--dcl-color-black-80);
}

.lobby-live-event-card__badges {
    position: absolute;
    top: 8px;
    left: 8px;
    height: 26px;
    flex-direction: row;
    align-items: center;
}

.lobby-live-event-card__live {
    height: 26px;
    margin-right: 6px;
    flex-direction: row;
    align-items: center;
    padding: 0 6px;
    border-radius: 8px;
    background-color: rgb(255, 0, 0);
}

.lobby-live-event-card__live-icon {
    width: 18px;
    height: 18px;
    margin-right: 4px;
    background-image: url('/Assets/Textures/ExplorePanel/LiveIcn.png');
}

.lobby-live-event-card__live-text {
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
}

.lobby-live-event-card__attendees {
    height: 26px;
    flex-direction: row;
    align-items: center;
    padding: 0 6px;
    border-radius: 8px;
    background-color: var(--dcl-color-shadow);
}

.lobby-live-event-card__attendees-dot {
    width: 8px;
    height: 8px;
    margin-right: 4px;
    border-radius: 4px;
    background-color: rgb(48, 205, 0);
}

.lobby-live-event-card__attendees-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    background-image: url('/Assets/Textures/Common/PlayersIcn.png');
}

.lobby-live-event-card__attendees-count {
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
}

.lobby-live-event-card__title {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 31px;
    height: 22px;
    font-size: 18px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: lower-left;
    color: var(--dcl-color-snow);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lobby-live-event-card__host {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 10px;
    height: 17px;
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-left;
    color: var(--dcl-color-white-70);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
