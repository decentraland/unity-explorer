<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/DCL/Lobby/UIToolkit/LobbyPlaceCard.uss" />
    <DCL.Lobby.LobbyPlaceCardElement name="PlaceCard" title="Place Name" creator="Creator" online-count="0">
        <ui:VisualElement name="Header" class="lobby-place-card__header" picking-mode="Ignore">
            <ui:VisualElement name="Thumbnail" class="lobby-place-card__thumbnail" picking-mode="Ignore" />
            <ui:VisualElement name="OnlineCounter" class="lobby-place-card__online" picking-mode="Ignore">
                <ui:VisualElement name="OnlineStatus" class="lobby-place-card__online-dot" picking-mode="Ignore" />
                <ui:VisualElement name="PlayerIcon" class="lobby-place-card__online-icon" picking-mode="Ignore" />
                <ui:Label name="OnlineCount" text="0" class="lobby-place-card__online-count" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="Footer" class="lobby-place-card__footer" picking-mode="Ignore">
            <ui:Label name="Title" text="Place Name" class="lobby-place-card__title" picking-mode="Ignore" />
            <ui:Label name="Creator" text="Creator" class="lobby-place-card__creator" picking-mode="Ignore" />
            <ui:Button name="JumpIn" text="JUMP IN" class="lobby-place-card__jump-in">
                <ui:VisualElement name="JumpInIcon" class="lobby-place-card__jump-in-icon" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
    </DCL.Lobby.LobbyPlaceCardElement>
</ui:UXML>
