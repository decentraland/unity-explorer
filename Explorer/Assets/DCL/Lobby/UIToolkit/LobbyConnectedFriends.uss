/* Hidden until a friend is there; the card stylesheets place the strip it sits in */
.lobby-connected-friends {
    display: none;
    height: 28px;
    flex-direction: row;
    align-items: center;
    padding: 0 6px;
    border-radius: 14px;
    background-color: var(--dcl-color-shadow);
}

.lobby-connected-friends--shown {
    display: flex;
}

/* The profile color and the picture are set inline by the element */
.lobby-connected-friends__picture {
    width: 24px;
    height: 24px;
    margin-left: -6px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.7);
    background-color: white;
    background-image: url('/Assets/DCL/Chat/Textures/DefaultProfileThumbnail.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
}

.lobby-connected-friends__picture:first-child {
    margin-left: 0;
}

.lobby-connected-friends__picture--loading {
    background-image: none;
}

.lobby-connected-friends__overflow {
    display: none;
    margin-left: 4px;
    margin-right: 2px;
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
}

.lobby-connected-friends--with-overflow .lobby-connected-friends__overflow {
    display: flex;
}
