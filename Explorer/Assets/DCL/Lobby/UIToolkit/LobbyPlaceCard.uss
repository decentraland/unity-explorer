:root {
    --place-card-hover-duration: 0.3s;
}

/* The Featured Places card of the design: 280x156 with 16px corners, the thumbnail filling it and the texts over its bottom */
.lobby-place-card {
    width: 280px;
    height: 156px;
    border-radius: 16px;
    background-color: var(--dcl-color-black-40);
    overflow: hidden;
}

.lobby-place-card__thumbnail {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url('/Assets/Textures/ExplorePanel/DefaultImagePlace.png');
    -unity-background-scale-mode: scale-and-crop;
}

/* Without a thumbnail the dark fill of the card shows */
.lobby-place-card--loading .lobby-place-card__thumbnail {
    background-image: none;
}

.lobby-place-card__online {
    position: absolute;
    top: 10px;
    left: 10px;
    height: 26px;
    flex-direction: row;
    align-items: center;
    padding: 0 6px;
    border-radius: 8px;
    background-color: var(--dcl-color-shadow);
}

.lobby-place-card__online-dot {
    width: 8px;
    height: 8px;
    margin-right: 4px;
    border-radius: 4px;
    background-color: rgb(48, 205, 0);
}

.lobby-place-card__online-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    background-image: url('/Assets/Textures/Common/PlayersIcn.png');
}

.lobby-place-card__online-count {
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    color: var(--dcl-color-snow);
}

/* Black fade under the texts, from clear at its top to solid at the bottom edge of the card; hovering makes room on its right
   for the Jump in button */
.lobby-place-card__footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 80px;
    padding: 0 20px 10px;
    justify-content: flex-end;
    background-image: url('/Assets/Textures/Common/GradientVertical.png');
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: black;
    transition: padding-right var(--place-card-hover-duration) ease-out;
}

.lobby-place-card:hover .lobby-place-card__footer {
    padding-right: 128px;
}

.lobby-place-card__title {
    height: 19px;
    margin-bottom: 4px;
    font-size: 16px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: lower-left;
    color: var(--dcl-color-snow);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lobby-place-card__creator {
    height: 15px;
    font-size: 12px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-left;
    color: var(--dcl-color-white-70);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Only reachable while the card is hovered, so its invisible state never takes a click meant for the card itself */
.lobby-place-card__jump-in {
    position: absolute;
    right: 12px;
    bottom: 12px;
    height: 32px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 0 10px 0 12px;
    border-radius: 8px;
    background-color: rgb(255, 45, 85);
    opacity: 0;
    transition: opacity var(--place-card-hover-duration) ease-out, background-color 0.1s;
}

.lobby-place-card:hover .lobby-place-card__jump-in {
    opacity: 1;
}

.lobby-place-card__jump-in:active {
    background-color: rgb(200, 35, 67);
}

.lobby-place-card__jump-in-text {
    margin-right: 4px;
    font-size: 12px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
}

.lobby-place-card__jump-in-icon {
    width: 20px;
    height: 20px;
    background-image: url('/Assets/Textures/Common/JumpInOutline.png');
}
