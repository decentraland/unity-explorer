:root {
    --community-card-hover-duration: 0.3s;
}

/* The footprint of the place card, so both rails line up. */
.lobby-community-card {
    width: 256px;
    height: 146px;
    border-width: 1px;
    border-radius: var(--lobby-card-radius);
    border-color: var(--lobby-card-border-color);
    background-color: var(--lobby-card-color);
    overflow: hidden;
}

.lobby-community-card__thumbnail {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url('/Assets/DCL/Communities/Textures/ThumbnailDefault.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: opacity var(--lobby-thumbnail-fade-duration) ease-out, scale var(--community-card-hover-duration) ease-out;
}

.lobby-community-card:hover .lobby-community-card__thumbnail {
    scale: 1.05;
}

/* The loaded picture fades in over the card fill instead of popping up. */
.lobby-community-card--loading .lobby-community-card__thumbnail {
    opacity: 0;
    transition: opacity 0s;
}

/* Sliced so the 52px fade keeps its shape while the flat strip stretches up to darken the hovered card. */
.lobby-community-card__gradient {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100px;
    background-image: url('/Assets/DCL/Lobby/Textures/CardBottomGradient.png');
    -unity-slice-top: 52;
    -unity-slice-bottom: 44;
    transition: height var(--community-card-hover-duration) ease-out;
}

.lobby-community-card:hover .lobby-community-card__gradient {
    height: 146px;
}

/* The hovered height adds the 36px View button and an 8px gap, lifting the texts above it. */
.lobby-community-card__footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 60px;
    padding: 0 16px 16px;
    transition: height var(--community-card-hover-duration) ease-out;
}

.lobby-community-card:hover .lobby-community-card__footer {
    height: 104px;
}

.lobby-community-card__title {
    height: 24px;
    margin-bottom: 4px;
    font-size: 18px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-left;
    color: var(--lobby-title-color);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lobby-community-card__members-row {
    height: 16px;
    flex-direction: row;
    align-items: center;
}

/* A 10px box fits the 20x20 globe at 10x10 and the 16x20 lock at 8x10, as designed. */
.lobby-community-card__visibility-icon {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    margin-right: 4px;
    background-image: url('/Assets/DCL/Communities/Textures/PublicIcn.png');
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    -unity-background-image-tint-color: var(--lobby-subtitle-color);
}

.lobby-community-card--private .lobby-community-card__visibility-icon {
    background-image: url('/Assets/DCL/Communities/Textures/PrivateIcn.png');
}

.lobby-community-card__visibility {
    flex-shrink: 0;
    font-size: 12px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-left;
    color: var(--lobby-subtitle-color);
}

.lobby-community-card__separator {
    flex-shrink: 0;
    width: 1px;
    height: 10px;
    margin: 0 6px;
    background-color: var(--lobby-white-60);
}

.lobby-community-card__members {
    flex-shrink: 1;
    font-size: 12px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-left;
    color: var(--lobby-subtitle-color);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Only reachable while hovered, so its invisible state never takes a click meant for the card. */
.lobby-community-card__view {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    height: 36px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    background-color: var(--lobby-white-5);
    opacity: 0;
    transition: opacity var(--community-card-hover-duration) ease-out, background-color 0.1s;
}

.lobby-community-card:hover .lobby-community-card__view {
    opacity: 1;
}

.lobby-community-card__view:hover {
    background-color: var(--lobby-white-10);
}

.lobby-community-card__view:active {
    background-color: var(--lobby-white-2);
}

.lobby-community-card__view-text {
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
}
