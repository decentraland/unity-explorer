:root {
    --community-card-hover-duration: 0.3s;
}

/* Same footprint as the place card (280x165, 24px corners): the thumbnail fills the card and a gradient darkens its bottom
   under the texts; hovering zooms the thumbnail */
.lobby-community-card {
    width: 280px;
    height: 165px;
    border-radius: 24px;
    background-color: var(--lobby-card-color);
    overflow: hidden;
}

.lobby-community-card__thumbnail {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url('/Assets/DCL/Communities/Textures/ThumbnailDefault.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transition: opacity var(--lobby-thumbnail-fade-duration) ease-out, scale var(--community-card-hover-duration) ease-out;
}

.lobby-community-card:hover .lobby-community-card__thumbnail {
    scale: 1.05;
}

/* While the picture is on its way the dark fill of the card shows; the picture then fades in over it rather than popping up */
.lobby-community-card--loading .lobby-community-card__thumbnail {
    opacity: 0;
    transition: opacity 0s;
}

/* The place card's sprite and slices: a 52px fade into a flat strip under the texts */
.lobby-community-card__gradient {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 100px;
    background-image: url('/Assets/DCL/Lobby/Textures/CardBottomGradient.png');
    -unity-slice-top: 52;
    -unity-slice-bottom: 44;
}

.lobby-community-card__private {
    position: absolute;
    top: 12px;
    left: 12px;
    height: 28px;
    flex-direction: row;
    align-items: center;
    padding: 0 8px 0 6px;
    border-radius: 12px;
    background-color: var(--dcl-color-shadow);
    display: none;
}

.lobby-community-card--private .lobby-community-card__private {
    display: flex;
}

.lobby-community-card__private-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    background-image: url('/Assets/DCL/Communities/Textures/PrivateIcn.png');
}

.lobby-community-card__private-text {
    font-size: 12px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    color: var(--dcl-color-snow);
}

.lobby-community-card__footer {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 55px;
    padding: 8px 10px 0;
}

.lobby-community-card__title {
    height: 20px;
    margin-bottom: 2px;
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: white;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.lobby-community-card__members-row {
    height: 16px;
    flex-direction: row;
    align-items: center;
}

.lobby-community-card__members-icon {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    margin-right: 4px;
    background-image: url('/Assets/Textures/Common/PlayersIcn.png');
    -unity-background-image-tint-color: var(--lobby-subtitle-color);
}

.lobby-community-card__members {
    flex-shrink: 1;
    font-size: 11px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-left;
    color: var(--lobby-subtitle-color);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
