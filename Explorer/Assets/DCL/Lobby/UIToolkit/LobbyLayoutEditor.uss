/* Edit mode of the layout (LobbyLayoutEditor): a handle covers the cells of each placed widget, the dragged widget
   follows the pointer on the drag layer and the marker shows the cells it would take and whether it can take them; the
   widgets a drop pushes slide to their new cells once it lands */
.lobby--editing .lobby__widget {
    transition: left 0.15s ease-out, top 0.15s ease-out;
}

/* The lifted widget keeps up with the pointer instead of easing after it, and lets the marker show through; the
   selector outranks the editing one above so the transition really goes */
.lobby--editing .lobby__widget.lobby__widget--lifted {
    transition-property: none;
    opacity: 0.85;
}

.lobby__layout-drag-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.lobby-widget-handle {
    position: absolute;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-radius: 12px;
    border-color: rgba(255, 255, 255, 0.35);
    transition: border-color 0.1s, left 0.15s ease-out, top 0.15s ease-out;
}

.lobby-widget-handle:hover {
    border-color: rgba(255, 255, 255, 0.7);
}

/* The handle of the dragged widget leaves its cells clear while the widget is on the move */
.lobby-widget-handle--dragging {
    visibility: hidden;
}

/* The button that takes a placed widget off its grid, in the corner of its handle */
.lobby-widget-handle__remove {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 32px;
    height: 32px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-radius: 16px;
    border-color: rgba(255, 255, 255, 0.35);
    background-color: rgba(0, 0, 0, 0.85);
    transition: border-color 0.1s, background-color 0.1s;
}

.lobby-widget-handle__remove:hover {
    border-color: rgba(255, 255, 255, 0.7);
    background-color: rgb(31, 31, 31);
}

.lobby-widget-handle__remove:active {
    background-color: black;
}

.lobby-widget-handle__remove-icon {
    width: 12px;
    height: 12px;
    background-image: url('/Assets/Textures/Common/CloseIcnThin.png');
}

/* The widget of a pushed handle previews its pushed cell alone (see LobbyLayoutEditor.ShowPushes) */
.lobby-widget-handle--pushed {
    display: none;
}

.lobby-widget-handle__label {
    padding: 6px 14px;
    border-radius: 14px;
    background-color: rgba(0, 0, 0, 0.85);
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--lobby-title-color);
}

/* A card of the widget modal (LobbyWidgetCardElement): the scaled preview of the family over its title; it dims while one
   of its sizes is on the move */
.lobby-widget-card {
    position: relative;
    margin-bottom: 12px;
    padding: 12px;
    border-width: 2px;
    border-radius: 12px;
    border-color: rgba(255, 255, 255, 0.2);
    background-color: rgba(255, 255, 255, 0.06);
    transition: border-color 0.1s, opacity 0.1s;
}

.lobby-widget-card:hover {
    border-color: rgba(255, 255, 255, 0.7);
}

.lobby-widget-card--dragging {
    opacity: 0.35;
}

/* Sized in code to the scaled preview of the first size of the family, which draws inside from the top-left corner */
.lobby-widget-card__preview-slot {
    align-self: center;
    margin-bottom: 10px;
}

.lobby-widget-card__footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    height: 28px;
}

.lobby-widget-card__title {
    font-size: 16px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-left;
    color: var(--lobby-title-color);
}

/* The span of a family of one size in cells, columns by rows */
.lobby-widget-card__size {
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-right;
    color: var(--lobby-subtitle-color);
}

/* The size buttons of a family of several sizes show while the card is hovered, and stay while a drag off one is on;
   they keep taking the pointer while faded out, which only matters under the pointer, where they show */
.lobby-widget-card__sizes {
    flex-direction: row;
    opacity: 0;
    transition: opacity 0.1s;
}

.lobby-widget-card:hover .lobby-widget-card__sizes,
.lobby-widget-card--dragging .lobby-widget-card__sizes {
    opacity: 1;
}

.lobby-widget-card__size-button {
    margin-left: 6px;
    padding: 4px 10px;
    border-width: 1px;
    border-radius: 12px;
    border-color: rgba(255, 255, 255, 0.35);
    background-color: rgba(0, 0, 0, 0.6);
    font-size: 12px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--lobby-title-color);
    transition: border-color 0.1s, background-color 0.1s;
}

.lobby-widget-card__size-button:hover {
    border-color: rgba(255, 255, 255, 0.8);
    background-color: rgb(31, 31, 31);
}

/* Stand-in of a widget off the grids (LobbyWidgetPreviewElement): its title over blank cards at the size of its span. It is
   scaled in code from its top-left corner, down to fit a card of the modal and back up while dragged off it */
.lobby-widget-preview {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: left top;
    padding: 16px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    background-color: rgba(20, 20, 26, 0.6);
}

.lobby-widget-preview.lobby__widget--lifted {
    opacity: 0.85;
}

.lobby-widget-preview__title {
    height: 29px;
    margin-bottom: 10px;
    font-size: 24px;
    -unity-font-definition: var(--dcl-font-inter-bold);
    -unity-text-align: upper-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--lobby-title-color);
}

/* The negative margin swallows the trailing gap of the last card */
.lobby-widget-preview__cards {
    flex-grow: 1;
    flex-direction: row;
    margin-right: -8px;
}

.lobby-widget-preview__card {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 8px;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    background-color: rgba(255, 255, 255, 0.1);
}

/* Over the avatar, between the top grids and as tall as them at most; it goes green while a dragged widget would drop into it */
.lobby__widget-modal {
    display: none;
    position: absolute;
    left: 50%;
    top: var(--lobby-columns-top);
    width: 480px;
    max-height: 640px;
    translate: -50% 0;
    padding: 20px;
    border-width: 2px;
    border-radius: 16px;
    border-color: var(--lobby-card-border-color);
    background-color: var(--lobby-card-color);
    transition: border-color 0.1s, background-color 0.1s;
}

.lobby--editing .lobby__widget-modal {
    display: flex;
}

.lobby__widget-modal--target {
    border-color: rgb(67, 214, 141);
    background-color: rgba(20, 50, 36, 0.9);
}

.lobby__widget-modal-title {
    height: 30px;
    font-size: 24px;
    -unity-font-definition: var(--dcl-font-inter-bold);
    -unity-text-align: middle-left;
    color: var(--lobby-title-color);
}

.lobby__widget-modal-hint {
    margin-top: 4px;
    margin-bottom: 16px;
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    white-space: normal;
    color: var(--lobby-subtitle-color);
}

/* The cards scroll inside the room the modal leaves them, past a thin bar with no end buttons */
.lobby__widget-modal-items {
    flex-shrink: 1;
}

.lobby__widget-modal-items .unity-scroll-view__vertical-scroller {
    width: 8px;
    margin-left: 12px;
}

.lobby__widget-modal-items .unity-scroll-view__vertical-scroller > .unity-repeat-button {
    display: none;
}

.lobby__widget-modal-items .unity-scroll-view__vertical-scroller > .unity-scroller__slider {
    margin: 0;
    min-width: 8px;
    width: 8px;
}

.lobby__widget-modal-items .unity-scroll-view__vertical-scroller .unity-base-slider__tracker {
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.08);
}

.lobby__widget-modal-items .unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    left: 0;
    width: 8px;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.35);
}

.lobby__widget-modal-items .unity-scroll-view__vertical-scroller .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.6);
}

/* Under the handles of its grid, over the sections: the arrows of the rails hang 39px outside their widgets (the margin
   of the track in LobbyRail.uss), so it reaches out by as much on each side to catch the pointer there too */
.lobby-grid-shield {
    position: absolute;
    left: -39px;
    right: -39px;
    top: 0;
    bottom: 0;
}

.lobby-drop-marker {
    position: absolute;
    border-width: 2px;
    border-radius: 12px;
}

.lobby-drop-marker--valid {
    border-color: rgb(67, 214, 141);
    background-color: rgba(67, 214, 141, 0.15);
}

.lobby-drop-marker--invalid {
    border-color: var(--lobby-jump-in-color);
    background-color: rgba(255, 45, 85, 0.15);
}
