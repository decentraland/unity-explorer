/* Edit mode of the layout (LobbyLayoutEditor): a handle frames the cells of each placed widget, the dragged widget follows
   the pointer on the drag layer in a frame of its own and the marker shows the cells it would take and whether it can take
   them; the widgets a drop pushes slide to their new cells once it lands */
.lobby--editing .lobby__widget {
    transition: left 0.15s ease-out, top 0.15s ease-out;
}

/* The lifted widget keeps up with the pointer instead of easing after it; the selector outranks the editing one above so
   the transition really goes */
.lobby--editing .lobby__widget.lobby__widget--lifted {
    transition-property: none;
}

.lobby__layout-drag-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Under the lifted widget, reaching past its cells like a handle: the handle frame, brighter */
.lobby-drag-frame {
    position: absolute;
    border-width: 2px;
    border-radius: 24px;
    border-color: rgba(255, 255, 255, 0.2);
    background-color: rgba(255, 255, 255, 0.1);
}

/* The frame draws over the widget, its tint under it (the underlay), so the widget itself keeps its colours */
.lobby-widget-handle {
    position: absolute;
    border-width: 2px;
    border-radius: 24px;
    border-color: rgba(255, 255, 255, 0.1);
    transition: border-color 0.1s, left 0.15s ease-out, top 0.15s ease-out;
}

.lobby-widget-handle__underlay {
    position: absolute;
    border-radius: 24px;
    background-color: rgba(255, 255, 255, 0.05);
    transition: left 0.15s ease-out, top 0.15s ease-out;
}

.lobby-widget-handle:hover {
    border-color: rgba(255, 255, 255, 0.2);
}

/* The handle of the dragged widget, and its underlay, leave its cells clear while the widget is on the move */
.lobby-widget-handle--dragging {
    visibility: hidden;
}

/* The button that takes a placed widget off its grid, in the corner of its handle */
.lobby-widget-handle__remove {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 32px;
    height: 32px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: 16px;
    background-color: var(--dcl-color-shadow);
    transition: background-color 0.1s;
}

.lobby-widget-handle__remove:hover {
    background-color: rgb(43, 42, 46);
}

.lobby-widget-handle__remove:active {
    background-color: black;
}

.lobby-widget-handle__remove-icon {
    width: 12px;
    height: 12px;
    background-image: url('/Assets/Textures/Common/CloseIcnThin.png');
}

/* The widget of a pushed handle previews its pushed cell alone, without the handle or its underlay (see
   LobbyLayoutEditor.ShowPushes) */
.lobby-widget-handle--pushed {
    display: none;
}

/* A row of the widget modal (LobbyWidgetCardElement): the grip, the icon and the title of a family off the grids; it dims
   while one of its sizes is on the move. The hover border is part of the box, so the padding gives it its pixel back */
.lobby-widget-card {
    flex-direction: row;
    align-items: center;
    height: 44px;
    margin-bottom: 4px;
    padding: 9px 19px 9px 3px;
    border-width: 1px;
    border-radius: 12px;
    border-color: rgba(255, 255, 255, 0);
    background-color: rgba(255, 255, 255, 0.02);
    transition: border-color 0.1s, opacity 0.1s;
}

.lobby-widget-card:hover {
    border-color: rgba(255, 255, 255, 0.6);
}

.lobby-widget-card--dragging {
    opacity: 0.35;
}

/* Two columns of three dots, each a vertical menu icon */
.lobby-widget-card__grip {
    width: 24px;
    height: 24px;
    margin-right: 10px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.lobby-widget-card__grip-column {
    width: 5px;
    height: 18px;
    margin: 0 1.5px;
    background-image: url('/Assets/Textures/Common/MenuVerticalIcn.png');
    -unity-background-image-tint-color: var(--dcl-color-silver);
}

.lobby-widget-card__icon {
    width: 24px;
    height: 24px;
    margin-right: 10px;
}

.lobby-widget-card__icon--landing {
    background-image: url('/Assets/Textures/ExplorePanel/HomeOutline.png');
}

.lobby-widget-card__icon--live-events {
    background-image: url('/Assets/Textures/ExplorePanel/LiveIcn.png');
}

.lobby-widget-card__icon--upcoming-events {
    background-image: url('/Assets/Textures/Common/CalendarIcn.png');
}

.lobby-widget-card__icon--friends-online {
    background-image: url('/Assets/Textures/Common/FriendIcn.png');
}

.lobby-widget-card__icon--jump-back-in {
    background-image: url('/Assets/Textures/Common/TimeIcn.png');
}

.lobby-widget-card__icon--recommended-places {
    background-image: url('/Assets/Textures/ExplorePanel/MyPlacesIcn.png');
}

.lobby-widget-card__icon--communities {
    background-image: url('/Assets/Textures/Common/CommunitiesIcn.png');
}

.lobby-widget-card__icon--gallery {
    background-image: url('/Assets/DCL/InWorldCamera/InWorldCamera/UI/Textures/CameraReelIcn.png');
}

.lobby-widget-card__icon--go-to {
    background-image: url('/Assets/Textures/Common/LocationIcn.png');
}

.lobby-widget-card__title {
    flex-grow: 1;
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-left;
    color: var(--lobby-title-color);
}

/* The size toggles of a family of several sizes, at the right end of the row */
.lobby-widget-card__sizes {
    flex-direction: row;
    padding: 2px;
    border-radius: 12px;
    background-color: rgba(0, 0, 0, 0.35);
}

.lobby-widget-card__size-toggle {
    padding: 2px 8px;
    border-width: 0;
    border-radius: 10px;
    font-size: 12px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-silver);
    transition: background-color 0.1s, color 0.1s;
}

.lobby-widget-card__size-toggle:hover {
    background-color: rgba(255, 255, 255, 0.04);
}

.lobby-widget-card__size-toggle--selected {
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--lobby-title-color);
}

/* Stand-in of a widget off the grids (LobbyWidgetPreviewElement), lifted while dragged off its row: its title over blank
   cards at the size of its span, laid out like a section so the drag frame fits around it */
.lobby-widget-preview {
    position: absolute;
    left: 0;
    top: 0;
}

.lobby-widget-preview__title {
    height: 29px;
    margin-bottom: 10px;
    font-size: 24px;
    -unity-font-definition: var(--dcl-font-inter-bold);
    -unity-text-align: upper-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--lobby-title-color);
}

/* The negative margin swallows the trailing gap of the last card */
.lobby-widget-preview__cards {
    flex-grow: 1;
    flex-direction: row;
    margin-right: -8px;
}

.lobby-widget-preview__card {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 8px;
    border-radius: 16px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    background-color: rgba(255, 255, 255, 0.1);
}

/* Over the avatar, between the top grids and as tall as them (640px, their six rows of cells). The design draws it 598px
   wide between 472px grids; the 136px cells make the grids 568px, so it is narrowed to leave the same room on each side.
   It goes green while a dragged widget would drop into it */
.lobby__widget-modal {
    display: none;
    position: absolute;
    left: 50%;
    top: var(--lobby-columns-top);
    width: 480px;
    height: 640px;
    translate: -50% 0;
    padding: 40px 36px;
    border-width: 1px;
    border-radius: 24px;
    border-color: rgba(255, 255, 255, 0.1);
    background-color: rgba(0, 0, 0, 0.98);
    transition: border-color 0.1s, background-color 0.1s;
}

.lobby--editing .lobby__widget-modal {
    display: flex;
}

.lobby__widget-modal--target {
    border-color: rgb(52, 206, 119);
    background-color: rgba(14, 40, 27, 0.9);
}

.lobby__widget-modal-title {
    height: 27px;
    font-size: 22px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-left;
    color: var(--dcl-color-snow);
}

.lobby__widget-modal-hint {
    margin-top: 10px;
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    white-space: normal;
    color: rgb(207, 205, 212);
}

/* The rows take the room between the hint and the buttons and scroll inside it, past a thin bar with no end buttons */
.lobby__widget-modal-items {
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: 40px;
}

.lobby__widget-modal-items .unity-scroll-view__vertical-scroller {
    width: 8px;
    margin-left: 12px;
}

.lobby__widget-modal-items .unity-scroll-view__vertical-scroller > .unity-repeat-button {
    display: none;
}

.lobby__widget-modal-items .unity-scroll-view__vertical-scroller > .unity-scroller__slider {
    margin: 0;
    min-width: 8px;
    width: 8px;
}

.lobby__widget-modal-items .unity-scroll-view__vertical-scroller .unity-base-slider__tracker {
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.08);
}

.lobby__widget-modal-items .unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    left: 0;
    width: 8px;
    border-width: 0;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.35);
}

.lobby__widget-modal-items .unity-scroll-view__vertical-scroller .unity-base-slider__dragger:hover {
    background-color: rgba(255, 255, 255, 0.6);
}

/* Reset on the left, Cancel and Save on the right */
.lobby__widget-modal-actions {
    flex-direction: row;
    align-items: center;
    margin-top: 40px;
}

.lobby__widget-modal-actions-spacer {
    flex-grow: 1;
}

.lobby__widget-modal-button {
    height: 42px;
    padding: 0 16px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: 12px;
    background-color: rgb(43, 42, 48);
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
    transition: background-color 0.1s, opacity 0.1s;
}

.lobby__widget-modal-button:hover {
    background-color: rgb(58, 57, 64);
}

.lobby__widget-modal-button:active {
    background-color: rgb(33, 32, 37);
}

.lobby__widget-modal-button--fixed {
    width: 110px;
    margin-left: 12px;
    padding: 0;
}

.lobby__widget-modal-button--primary {
    background-color: var(--lobby-jump-in-color);
}

.lobby__widget-modal-button--primary:hover {
    background-color: var(--lobby-jump-in-hover-color);
}

.lobby__widget-modal-button--primary:active {
    background-color: var(--lobby-jump-in-pressed-color);
}

/* Save waits, faded, until there is a change to store */
.lobby__widget-modal-button--primary:disabled {
    opacity: 0.2;
}

.lobby__widget-modal-save-icon {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    background-image: url('/Assets/Textures/Common/CheckmarkIcnThick.png');
}

.lobby__widget-modal-save-label {
    font-size: 14px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
}

/* Under the handles of its grid, over the sections: the arrows of the rails hang 39px outside their widgets (the margin
   of the track in LobbyRail.uss), so it reaches out by as much on each side to catch the pointer there too */
.lobby-grid-shield {
    position: absolute;
    left: -39px;
    right: -39px;
    top: 0;
    bottom: 0;
}

/* The cells the dragged widget would take, tinted by whether the drop can take them */
.lobby-drop-marker {
    position: absolute;
    border-radius: 6px;
}

.lobby-drop-marker--valid {
    background-color: rgba(52, 206, 119, 0.1);
}

.lobby-drop-marker--invalid {
    background-color: rgba(255, 45, 85, 0.1);
}