<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/DCL/Lobby/UIToolkit/LobbyLiveEventCard.uss" />
    <Style src="project://database/Assets/DCL/Lobby/UIToolkit/LobbyConnectedFriends.uss" />
    <DCL.Lobby.LobbyLiveEventCardElement name="LiveEventCard" title="Event Name" host="By Host" attendees="0">
        <ui:VisualElement name="Shadow" class="lobby-live-event-card__shadow" picking-mode="Ignore" />
        <!-- The body clips its layers to the corners; the shadow hangs past them -->
        <ui:VisualElement name="Body" class="lobby-live-event-card__body" picking-mode="Ignore">
            <ui:VisualElement name="Thumbnail" class="lobby-live-event-card__thumbnail" picking-mode="Ignore" />
            <ui:VisualElement name="Gradient" class="lobby-live-event-card__gradient" picking-mode="Ignore" />
            <ui:VisualElement name="Badges" class="lobby-live-event-card__badges" picking-mode="Ignore">
                <ui:VisualElement name="LiveBadge" class="lobby-live-event-card__live" picking-mode="Ignore">
                    <ui:VisualElement name="LiveIcon" class="lobby-live-event-card__live-icon" picking-mode="Ignore" />
                    <ui:Label name="LiveText" text="LIVE" class="lobby-live-event-card__live-text" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="AttendeesCounter" class="lobby-live-event-card__attendees" picking-mode="Ignore">
                    <ui:VisualElement name="OnlineStatus" class="lobby-live-event-card__attendees-dot" picking-mode="Ignore" />
                    <ui:VisualElement name="PlayerIcon" class="lobby-live-event-card__attendees-icon" picking-mode="Ignore" />
                    <ui:Label name="Attendees" text="0" class="lobby-live-event-card__attendees-count" picking-mode="Ignore" />
                </ui:VisualElement>
                <DCL.Lobby.LobbyConnectedFriendsElement name="ConnectedFriends" />
            </ui:VisualElement>
            <ui:Label name="Title" text="Event Name" enable-rich-text="false" class="lobby-live-event-card__title" picking-mode="Ignore" />
            <ui:Label name="Host" text="By Host" enable-rich-text="false" class="lobby-live-event-card__host" picking-mode="Ignore" />
            <ui:Button name="JumpIn" class="lobby-live-event-card__jump-in">
                <ui:Label name="JumpInText" text="JUMP IN" class="lobby-live-event-card__jump-in-text" picking-mode="Ignore" />
                <ui:VisualElement name="JumpInIcon" class="lobby-live-event-card__jump-in-icon" picking-mode="Ignore" />
            </ui:Button>
        </ui:VisualElement>
    </DCL.Lobby.LobbyLiveEventCardElement>
</ui:UXML>
