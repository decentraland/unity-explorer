/* Both bars are centred in the 100px header band: the header on the left holds the wordmark, the title and the edit button,
   the top bar on the right the widgets and the round buttons */
.lobby__header {
    position: absolute;
    top: 27px;
    left: var(--lobby-margin);
    height: 46px;
    flex-direction: row;
    align-items: center;
}

.lobby__logo {
    width: 175px;
    height: 24px;
    background-image: url('/Assets/Textures/ExplorePanel/DecentralandLogo.png');
}

.lobby__header-title {
    margin-left: 2px;
    font-size: 26px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-left;
    color: var(--dcl-color-silver);
}

.lobby__edit-layout-button {
    width: 42px;
    height: 42px;
    margin-left: 12px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-radius: 21px;
    border-color: var(--dcl-color-white-10);
    background-color: var(--dcl-color-black-70);
    transition: background-color 0.1s;
}

.lobby__edit-layout-button:hover {
    background-color: rgb(31, 31, 31);
}

.lobby__edit-layout-button:active {
    background-color: var(--dcl-color-black-70);
}

.lobby__edit-layout-icon {
    width: 24px;
    height: 24px;
    background-image: url('/Assets/Textures/Common/EditIcn.png');
}

.lobby__top-bar {
    position: absolute;
    top: 27px;
    right: var(--lobby-margin);
    height: 46px;
    flex-direction: row;
    align-items: center;
}

/* The credits and profile widgets are moved into the slots at runtime; a slot is only as big as what it holds */
.lobby__top-bar-slot {
    flex-direction: row;
    margin-left: 10px;
}

/* The profile widget of the lobby shows the name alone, like the uGUI one whose wallet tag is disabled */
.lobby__top-bar .profile-widget__address {
    display: none;
}

.lobby__top-bar-button {
    width: 40px;
    height: 40px;
    margin-left: 10px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-radius: 20px;
    border-color: rgba(255, 255, 255, 0.03);
    background-color: black;
    transition: background-color 0.1s;
}

.lobby__top-bar-button:hover {
    background-color: rgb(31, 31, 31);
}

.lobby__top-bar-button:active {
    background-color: black;
}

.lobby__notifications-icon {
    width: 22px;
    height: 22px;
    background-image: url('/Assets/Textures/Common/NotificationIcn.png');
}

.lobby__notifications-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 9px;
    background-color: rgb(255, 45, 85);
    font-size: 11px;
    -unity-font-definition: var(--dcl-font-inter-bold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
}

.lobby__close-icon {
    width: 12px;
    height: 12px;
    background-image: url('/Assets/Textures/Common/CloseIcnThin.png');
}

/* While the layout is edited the same button leaves edit mode, so it reads as Done */
.lobby--editing .lobby__edit-layout-button {
    background-color: var(--lobby-jump-in-color);
}

.lobby--editing .lobby__edit-layout-button:hover {
    background-color: var(--lobby-jump-in-hover-color);
}

.lobby--editing .lobby__edit-layout-button:active {
    background-color: var(--lobby-jump-in-pressed-color);
}

.lobby--editing .lobby__edit-layout-icon {
    background-image: url('/Assets/Textures/Common/CheckmarkIcnThick.png');
}
