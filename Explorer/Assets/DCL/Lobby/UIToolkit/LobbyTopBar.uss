/* Both bars are centred in the 100px header band: the header on the left holds the wordmark, the title and the edit button,
   the top bar on the right the widgets and the round buttons. As in the design, every pill is 42px tall and centred in the
   46px band that only the profile widget fills */
.lobby__header {
    position: absolute;
    top: 27px;
    left: var(--lobby-margin);
    height: 46px;
    flex-direction: row;
    align-items: center;
}

.lobby__logo {
    width: 175px;
    height: 24px;
    background-image: url('/Assets/Textures/ExplorePanel/DecentralandLogo.png');
}

.lobby__header-title {
    margin-left: 2px;
    font-size: 26px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-left;
    color: var(--dcl-color-silver);
}

.lobby__edit-layout-button {
    width: 42px;
    height: 42px;
    margin-left: 16px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-radius: 21px;
    border-color: var(--lobby-white-5);
    background-color: var(--dcl-color-black-70);
    transition: background-color 0.1s;
}

.lobby__edit-layout-button:hover {
    background-color: rgb(31, 31, 31);
}

.lobby__edit-layout-button:active {
    background-color: var(--dcl-color-black-70);
}

.lobby__edit-layout-icon {
    width: 24px;
    height: 24px;
    background-image: url('/Assets/Textures/Common/EditIcn.png');
}

.lobby__top-bar {
    position: absolute;
    top: 27px;
    right: var(--lobby-margin);
    height: 46px;
    flex-direction: row;
    align-items: center;
}

/* The credits and profile widgets are moved into the slots at runtime; a slot is only as big as what it holds */
.lobby__top-bar-slot {
    flex-direction: row;
    margin-left: 10px;
}

/* The profile widget of the lobby shows the name alone, like the uGUI one whose wallet tag is disabled */
.lobby__top-bar .profile-widget__address {
    display: none;
}

.lobby__top-bar .profile-widget {
    border-color: var(--lobby-white-5);
}

/* Pill opening an explore section over the lobby: the shape and the fill of the profile widget beside it */
.lobby__top-bar-pill {
    height: 42px;
    margin-left: 10px;
    padding: 0 18px 0 14px;
    flex-direction: row;
    align-items: center;
    border-width: 2px;
    border-radius: 21px;
    border-color: var(--lobby-white-5);
    background-color: rgba(0, 0, 0, 0.55);
    transition: background-color 0.1s;
}

.lobby__top-bar-pill:hover {
    background-color: rgba(90, 90, 90, 0.55);
}

.lobby__top-bar-pill:active {
    background-color: rgba(0, 0, 0, 0.55);
}

.lobby__top-bar-pill-icon {
    width: 32px;
    height: 32px;
}

.lobby__top-bar-pill-label {
    margin-left: 8px;
    font-size: 16px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    color: var(--dcl-color-snow);
}

.lobby__map-icon {
    background-image: url('/Assets/Textures/Common/MapIcn.png');
}

.lobby__places-icon {
    background-image: url('/Assets/Textures/ExplorePanel/PlacesOff.png');
}

.lobby__events-icon {
    background-image: url('/Assets/Textures/ExplorePanel/EventsOff.png');
}

.lobby__top-bar-button {
    width: 42px;
    height: 42px;
    margin-left: 10px;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-radius: 21px;
    border-color: var(--lobby-white-5);
    background-color: rgba(0, 0, 0, 0.55);
    transition: background-color 0.1s;
}

.lobby__top-bar-button:hover {
    background-color: rgba(90, 90, 90, 0.55);
}

.lobby__top-bar-button:active {
    background-color: rgba(0, 0, 0, 0.55);
}

/* The bell texture has less padding than the pill icons, so a smaller box keeps the visible glyph the same height */
.lobby__notifications-icon {
    width: 28px;
    height: 28px;
    background-image: url('/Assets/Textures/Common/NotificationIcn.png');
}

.lobby__top-bar-button--open,
.lobby__top-bar-button--open:active {
    background-color: rgba(90, 90, 90, 0.55);
}

/* The lit frame of the sidebar's bell animation is padded like the pill icons, so it takes their box */
.lobby__top-bar-button--open .lobby__notifications-icon {
    width: 32px;
    height: 32px;
    background-image: url('/Assets/Textures/ExplorePanel/NotificationsHover/NotificationIcon_00062.png');
}

.lobby__notifications-badge {
    position: absolute;
    top: -6px;
    right: -6px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 9px;
    background-color: rgb(255, 45, 85);
    font-size: 11px;
    -unity-font-definition: var(--dcl-font-inter-bold);
    -unity-text-align: middle-center;
    color: var(--dcl-color-snow);
}

/* The Back pill of the top bar, sized like the pills beside it and coloured like the design's pills */
.lobby__top-bar-back-button {
    height: 42px;
    margin-left: 10px;
    padding: 0 16px 0 14px;
    flex-direction: row;
    align-items: center;
    border-width: 2px;
    border-radius: 21px;
    border-color: var(--lobby-white-5);
    background-color: rgba(0, 0, 0, 0.6);
    transition: background-color 0.1s;
}

.lobby__top-bar-back-button:hover {
    background-color: rgba(31, 31, 31, 0.8);
}

.lobby__top-bar-back-button:active {
    background-color: rgba(0, 0, 0, 0.6);
}

/* The key that does the same as the pill, in brackets and dimmed beside its text */
.lobby__back-key {
    margin-left: 6px;
    font-size: 16px;
    -unity-font-definition: var(--dcl-font-inter-regular);
    -unity-text-align: middle-center;
    color: var(--dcl-color-silver);
}

/* The modal takes over while the layout is edited, with its own Cancel and Save, so the button steps aside for Back */
.lobby--editing .lobby__edit-layout-button {
    display: none;
}

/* The Back pill of the edit mode, styled like the edit button it replaces */
.lobby__back-button {
    display: none;
    height: 42px;
    margin-left: 16px;
    padding: 0 16px 0 14px;
    flex-direction: row;
    align-items: center;
    border-width: 2px;
    border-radius: 21px;
    border-color: var(--lobby-white-5);
    background-color: rgba(0, 0, 0, 0.6);
    transition: background-color 0.1s;
}

.lobby--editing .lobby__back-button {
    display: flex;
}

.lobby__back-button:hover {
    background-color: rgba(31, 31, 31, 0.8);
}

.lobby__back-button:active {
    background-color: rgba(0, 0, 0, 0.6);
}

.lobby__back-icon {
    width: 9px;
    height: 14px;
    margin-right: 12px;
    background-image: url('/Assets/Textures/Common/ArrowLeft.png');
}

.lobby__back-text {
    font-size: 16px;
    -unity-font-definition: var(--dcl-font-inter-semibold);
    -unity-text-align: middle-center;
    color: var(--lobby-title-color);
}

/* The panel hangs 8px under the bar, right-aligned with the profile widget */
.lobby__profile-menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.lobby__profile-menu .lobby-profile-menu__panel {
    top: 81px;
    right: var(--lobby-margin);
}

/* In-world the Back pill sits right of the widget: its content width plus its 10px margin */
.lobby__profile-menu--with-back .lobby-profile-menu__panel {
    right: 193px;
}
