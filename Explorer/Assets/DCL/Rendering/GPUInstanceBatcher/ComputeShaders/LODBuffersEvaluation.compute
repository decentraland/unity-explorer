#include "Includes/PlatformSpecifications.cginc"
#include "Includes/Structures.cginc"

// Uncomment for debug symbols - do not commit uncommented
//#pragma enable_d3d11_debug_symbols
#pragma kernel ComputeLODBufferAccumulation

////////////////////
// UNIFORM INPUTS
////////////////////
shared RWStructuredBuffer<uint> arrLODCount;
RWStructuredBuffer<PerInstanceLODLevels> PerInstance_LODLevels; // LOD_A, LOD_B, LOD_Dither, LOD_Shadow
StructuredBuffer<GroupData> GroupDataBuffer;

////////////////////
// UNIFORM OUTPUTS
////////////////////
RWStructuredBuffer<InstanceLookUpAndDither> InstanceLookUpAndDitherBuffer;

// Group-shared reduction: threads reserve compaction slots in group-local counters
// first, then flush ONE global atomic per bucket per thread-group into arrLODCount
// (instead of one contended global atomic per instance). GPUI_THREADS >= 8 on every
// target platform, so gi in [0,8) always covers all buckets.
groupshared uint gsLocal[8];
groupshared uint gsBase[8];

[numthreads(GPUI_THREADS, 1, 1)]
void ComputeLODBufferAccumulation(uint3 id : SV_DispatchThreadID, uint gi : SV_GroupIndex)
{
    // Phase 1: zero the group-local bucket counters.
    if (gi < 8)
        gsLocal[gi] = 0;
    GroupMemoryBarrierWithGroupSync();

    uint nInstBufferSize = GroupDataBuffer[0].nInstBufferSize;
    uint nLODCount = GroupDataBuffer[0].nLODCount;
    bool alive = id.x < nInstBufferSize;

    // Phase 2: reserve group-local slots. No global atomics on the hot bucket address.
    // Bucket mapping preserved verbatim from the old if/else ladder:
    //   LOD_A  -> bucket nLOD_A          (dither = LOD_Dither)
    //   crossfade (nLOD_A in 0..6 and nLOD_B valid) -> bucket nLOD_A + 1 (dither = 0)
    // nLOD_A == 7 has no crossfade branch, matching the original.
    uint nLOD_A = 0;
    uint nDitherA = 0;
    bool doA = false;
    bool doB = false;
    uint bucketA = 0;
    uint bucketB = 0;
    uint localA = 0;
    uint localB = 0;
    if (alive)
    {
        nLOD_A = PerInstance_LODLevels[id.x].LOD_A;
        uint nLOD_B = PerInstance_LODLevels[id.x].LOD_B;
        nDitherA = PerInstance_LODLevels[id.x].LOD_Dither;
        if (nLOD_A < nLODCount)
        {
            doA = true;
            bucketA = nLOD_A;
            InterlockedAdd(gsLocal[bucketA], 1, localA);
            if (nLOD_A < 7 && nLOD_B < nLODCount)
            {
                doB = true;
                bucketB = nLOD_A + 1;
                InterlockedAdd(gsLocal[bucketB], 1, localB);
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();

    // Phase 3: one global atomic per bucket per group, capturing this group's base offset.
    if (gi < 8)
        InterlockedAdd(arrLODCount[gi], gsLocal[gi], gsBase[gi]);
    GroupMemoryBarrierWithGroupSync();

    // Phase 4: scatter into the compacted lookup buffer at group-base + intra-group offset.
    if (doA)
    {
        uint slotA = gsBase[bucketA] + localA + (nInstBufferSize * bucketA);
        InstanceLookUpAndDitherBuffer[slotA].nInstanceLookUp = id.x;
        InstanceLookUpAndDitherBuffer[slotA].nDither = nDitherA;
    }
    if (doB)
    {
        uint slotB = gsBase[bucketB] + localB + (nInstBufferSize * bucketB);
        InstanceLookUpAndDitherBuffer[slotB].nInstanceLookUp = id.x;
        InstanceLookUpAndDitherBuffer[slotB].nDither = 0;
    }
}